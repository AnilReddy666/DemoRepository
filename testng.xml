<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="My Test Suite" parallel = "tests" thread-count = "3" >
    <listeners>
        <listener class-name="listeners.AnnotationTransformer"/>
    </listeners>
    <test name = "Parameters Test">
        <parameter name = "browser" value = "chrome"/>
            <classes>
                <class name="tests.ParametersTest"></class>
                    <class name = "tests.ContextTest"></class>
                <class name = "tests.ContextTest2"></class>
                <class name = "tests.LoginTest"></class>
            </classes>

    </test>
    <test name="Firefox Parameters Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.ParametersTest"/>
        </classes>
    </test>

    <test name="Smoke Tests">

        <groups>
                <run>
                <include name = "regression"/>
                    <include name = "smoke"/>

        </run>
        </groups>
        <classes>
            <class name = "tests.PriorityTest"/>
        </classes>
    </test>

</suite>